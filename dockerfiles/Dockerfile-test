FROM node:22-alpine3.19

# # Expose the port
EXPOSE 3000

# # Set the working directory
WORKDIR /app

# # Install dependencies required for Playwright
RUN apk add --no-cache \
    chromium \
    firefox \
    webkit \
    # Dependencies for Playwright
    nss \
    freetype \
    freetype-dev \
    ttf-freefont \
    font-noto-emoji \
    # Dependencies for browsers
    dbus \
    xvfb \
    # Tools
    bash

# # Copy the app
COPY ../app/ /app/

# # Clean the environment and workspace
RUN rm -rf ./node_modules && \
    rm -rf ./package-lock.json && \
    rm -rf ./.nuxt && \
    rm -f /tmp/nitro/worker-*.sock

# # Install global dependencies
RUN npm install -g npm@latest

# # Install project dependencies and Playwright
RUN npm install && \
    npx playwright install-deps && \
    npm init playwright@latest -y && \
    npx playwright install --with-deps chromium && \
    npm run postinstall

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV PLAYWRIGHT_BROWSERS_PATH=/usr/lib/chromium

# # Par défaut, on ne met pas de CMD car on veut pouvoir exécuter différentes commandes